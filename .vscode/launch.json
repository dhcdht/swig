{
    // 使用 IntelliSense 了解相关属性。 
    // 悬停以查看现有属性的描述。
    // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "RunSwig",
            "program": "${workspaceFolder}/build/swig",
            "args": [
                "-c++",
                "-dart",
                "test/example.i",
            ],
            "cwd": "${workspaceFolder}/build"
        },
        {
            "name": "RunDartDemo",
            "request": "launch",
            "type": "dart",
            "program": "${workspaceFolder}/build/test_demo/example/lib/main.dart",
        },
        {
            "type": "lldb",
            "request": "attach",
            "name": "AttachCpp",
            "pid": "${command:pickMyProcess}" // use ${command:pickProcess} to pick other users' processes
        },
    ]
}